# Memika — environment variables
# Copy this file to .env and fill with values from your Supabase project (Settings → API).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: force offline demo mode even when Supabase creds are present.
# Useful during early development before real users are provisioned.
# Set to "true" to bypass Supabase auth and accept the two seed demo accounts
# (angelo.casula@gmail.com / memikaapp@gmail.com) with any password.
EXPO_PUBLIC_DEMO_MODE=false

# Sentry crash reporting (release builds only — Sentry.init is disabled when
# __DEV__ is true or this value is empty). Paste the DSN of the "memika-app"
# project (Sentry → Settings → Projects → Client Keys). The EU org host is
# https://oNNN.ingest.de.sentry.io/… — see docs/DEPLOY.md § Sentry.
# For EAS builds set it per profile in eas.json `env` (it is a public key).
EXPO_PUBLIC_SENTRY_DSN=
